
'''COMS pipeline commands:
in total you would have 5 terminals(or 6 if you check imu data) on the pi and 3 terminals on the laptop

instructions are divided in IMU, MEDIA (video+audio) and LED

for communicatoions check the ip is accurate for sender (pi) and receiver(laptop)
the commands are 
#for the pi
hostname -I 
#for the laptop 
ipconfig

''' 
work on the collection of files on both sides. th efiles for ros audio and the anaconda env file

___________________________________________________________

	#########################
	#1.a IMU stream (pi side)


#TERMINAL 1:
# Activate the virtual environment:
source .venv/bin/activate
# Go to the Documents folder:
cd Documents
# Run the python code
#check the ip is the pi one
python3 IMUstream.py

  #to check the ip you are running, make sure is the same one written on the file:
  hostname -I



#TERMINAL 2:
#to start the container:
#chek if its there
docker ps -a
#start
docker start ros_test
#excecute terminal
docker exec -it ros_test bash
#activate setup
source /opt/ros/humble/setup.bash
#find the container
cd root
ls
cd imu_test
#run the bridge
python3 imu_bridge.py
	
  #to access, create and edit the file
  nano imu_bridge.py
  #cntrol O + cntrol x to override and exit

	
#TERMINAL 3: to check the stream (optional/ debugging) ##CURRENTLY NOT RUNNING 
#execute terminal
docker exec -it ros_test bash
#activate setup
source /opt/ros/humble/setup.bash

	#inside root@RH-001:
#check for IMU data
ros2 topic list
#print imu data
ros2 topic echo /imu/data



	1.b IMU stream (laptop side)


#activate the conda environment
conda activate ros_env1
#check for topic
ros2 topic list
#echo the topic
ros2 topic echo /imu/data



___________________________________________________________

	###############################################
	#2.a MEDIA listener VIDEO + AUDIO (laptop side)


#activate the environment
conda activate ros_env1
#change directory
cd  <path to file>
#execute the file
python media_receiver.py


2.b MEDIA sender VIDEO + AUDIO (pi side)

#TERMINAL 1
#to stream
#change directory
cd media
#execute file
#turn on speaker/mic
python3 m_audio_stream.py



#TERMINAL 2
#change directory
cd media
#execute file
python3 m_camera_udp_commands.py


___________________________________________________________

	##################
	#3.a LED (pi side)

#source the enviroment>change directory>execute file
source .venv/bin/activate
cd media
sudo -E PATH=$PATH python3 LED_server.py


	3.b LED (laptop side)

#run the script
python led_control.py
#commands are ON, OFF and Q to exit



